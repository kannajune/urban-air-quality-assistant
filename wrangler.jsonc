{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "urban-air-quality-assistant",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Every request goes through the Worker first, so static files get the security headers too.
    "run_worker_first": true
  },
  "vars": {
    // The model is configuration, so it changes without a code edit.
    "WORKERS_AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    // Exact limits enforced by the RateLimiter Durable Object.
    "LIMIT_VISITOR_PER_MINUTE": "5",
    "LIMIT_VISITOR_PER_DAY": "40",
    "LIMIT_AI_PER_DAY": "200"
  },
  // First layer: Cloudflare's approximate edge limiter, which sheds heavy bursts cheaply.
  // The exact limits are enforced by the RateLimiter Durable Object below.
  "ratelimits": [
    {
      "name": "VISITOR_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 6, "period": 60 }
    },
    {
      "name": "APP_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 40, "period": 60 }
    }
  ],
  // The plan is written by a model on Cloudflare Workers AI (free daily allowance, no API key to protect).
  "ai": { "binding": "AI" },
  // Exact counter behind the edge limiter: per visitor per minute and per day, and a whole app daily ceiling on AI calls.
  "durable_objects": {
    "bindings": [{ "name": "LIMITER", "class_name": "RateLimiter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }],
  "observability": {
    "enabled": true
  }
  // This app needs no secrets: the model is reached through the AI binding, not an API key.
}
